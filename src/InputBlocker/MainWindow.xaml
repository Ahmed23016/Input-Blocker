<Window x:Class="InputBlocker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Input Blocker" Width="760" Height="760" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button Content="Settings" Command="{Binding SettingsCommand}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="INPUT BLOCKER" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="A little space for work to finish." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Margin="0,32,0,24" Padding="38"><StackPanel HorizontalAlignment="Center" MaxWidth="440">
   <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="48" Width="96" Height="96" Margin="0,4,0,22"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="{Binding Status}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
   <TextBlock Text="Keep your desktop running. Give your keyboard and mouse a break." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" FontSize="16" Margin="0,14,0,24"/>
   <Button Content="Block Input" Command="{Binding BlockCommand}" Background="{DynamicResource AccentBrush}" Foreground="#101114" FontWeight="SemiBold" FontSize="17" Padding="60,16"/>
   <TextBlock Text="{Binding ShortcutLabel}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="0,14,0,4"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="2"><UniformGrid Columns="3"><Button Content="Change Password" Click="ChangePassword" Margin="0,0,8,0"/><Button Content="Keyboard Shortcut" Command="{Binding SettingsCommand}" Margin="0,0,8,0"/><Button Content="Auto Block" Command="{Binding SettingsCommand}"/></UniformGrid><DockPanel Margin="0,18,0,0"><Button Content="About" Click="About" DockPanel.Dock="Right"/><TextBlock Text="Casual input protection, with safe recovery.&#xA;Your Windows session stays signed in." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></DockPanel></StackPanel>
 </Grid></ScrollViewer>
</Window>
